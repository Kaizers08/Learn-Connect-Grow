# ── Scanner service config ───────────────────────────────────────────────────
# Copy to .env and fill in. Never commit the real .env.

# Port the scan service listens on.
# IMPORTANT: the hosting platform (Render/Railway/etc.) injects its own PORT —
# scanner/server.js already honours PORT, so leave this as a local default.
PORT=3030

# Shared secret between the Supabase Edge Function and this service.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this is empty, /scan refuses every request (fail-closed).
SCAN_API_KEY=change-me-to-a-long-random-string

# clamd daemon connection (ClamAV). Local only — never expose clamd's port.
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# Reject anything bigger than this many bytes (64MB default — the app caps
# mentor uploads at 50MB, so this is a defensive guard).
MAX_SCAN_BYTES=67108864

# How long a single file may take to scan (ms)
CLAMD_TIMEOUT_MS=120000

# Optional CORS allow-list. Not needed for server-to-server calls.
ALLOWED_ORIGIN=
